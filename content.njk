---
layout: layouts/base.njk
---
<article class="content-page">
  <header class="content-header">
    {% if source_label %}<p class="eyebrow">{{ source_label }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if summary %}<p class="lead">{{ summary }}</p>{% endif %}
    {% if source_name %}<p class="source-line">Source: <strong>{{ source_name }}</strong>{% if date %} · Date: {{ date | dateReadable }}{% endif %}</p>{% endif %}
  </header>
  {% if cover_image %}<img class="feature-image" src="{{ cover_image }}" alt="{{ title }} cover image">{% endif %}
  <div class="prose">{{ content | safe }}</div>
  {% if gallery and gallery.length %}
    <section class="section"><h2>Gallery</h2><div class="gallery-grid">
      {% for photo in gallery %}<figure><img src="{{ photo.image }}" alt="{{ photo.alt or title }}" loading="lazy">{% if photo.caption %}<figcaption>{{ photo.caption }}</figcaption>{% endif %}</figure>{% endfor %}
    </div></section>
  {% endif %}
  {% if video_url %}<section class="section"><h2>Journey video</h2><p><a class="text-link" href="{{ video_url }}" target="_blank" rel="noopener">Watch the journey video →</a></p>{% endif %}
  {% if related_itinerary %}<p><a class="button" href="{{ related_itinerary }}">Explore the related itinerary</a></p>{% endif %}
  <p class="notice">Travel details, prices and service-provider information can change. Verify before making a booking.</p>
</article>
