<article class="travel-card">
  <a href="{{ item.url }}">
    {% if item.data.cover_image %}<img class="card-image" src="{{ item.data.cover_image }}" alt="{{ item.data.title }} destination photograph" loading="lazy">{% else %}<div class="card-image image-placeholder"><span>Destination photograph</span></div>{% endif %}
    <div class="card-body">
      <p class="eyebrow">{{ item.data.region or item.data.country or "TRAVEL DESTINATION" }}</p>
      <h3>{{ item.data.title }}</h3>
      <p>{{ item.data.summary or item.data.description or "A destination story is coming soon." }}</p>
      <span class="text-link">Explore destination →</span>
    </div>
  </a>
</article>
