<article class="travel-card">
  <a href="{{ item.url }}">
    {% if item.data.cover_image %}<img class="card-image" src="{{ item.data.cover_image }}" alt="{{ item.data.title }}" loading="lazy">{% else %}<div class="card-image image-placeholder"><span>Story photograph</span></div>{% endif %}
    <div class="card-body">
      <p class="eyebrow">{{ item.data.source_type or "TRAVEL STORY" }}</p>
      <h3>{{ item.data.title }}</h3>
      <p>{{ item.data.summary or "A personal travel story." }}</p>
      <span class="text-link">Read the story →</span>
    </div>
  </a>
</article>
